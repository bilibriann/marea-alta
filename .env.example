# Formularios — Web3Forms (ver src/lib/forms.ts)
NEXT_PUBLIC_FORMS_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Conexión a MySQL — Productos y Noticias se leen de acá en build time
# (src/lib/productos.ts, src/lib/noticias.ts). El contenido se administra
# desde el panel en admin/, que escribe a la misma base. En desarrollo
# local apunta al contenedor de docker-compose.yml (raíz del repo); en
# producción, a la base de Hostinger.
DATABASE_URL="mysql://marea_alta:marea_alta@localhost:3306/marea_alta"

# Destino de TODO el correo del sitio (contacto, newsletter, cotizaciones).
# Constante única: src/config.ts → CONTACT_EMAIL. El dominio aún no está
# confirmado; cuando lo esté, se cambia aquí y no en el código.
NEXT_PUBLIC_CONTACT_EMAIL=ventas@mareaalta-latam.com
