# Conexión a MySQL. En desarrollo local apunta al contenedor de
# docker-compose.yml (raíz del repo); en producción, a la base de Hostinger.
DATABASE_URL="mysql://marea_alta:marea_alta@localhost:3306/marea_alta"

# Secreto para firmar la cookie de sesión (JWT). Generar con:
# openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Storage de imágenes. En desarrollo apunta al MinIO de docker-compose.yml
# (valores de ejemplo abajo); en producción, a Cloudflare R2 (mismo
# protocolo S3 — ver admin/src/lib/storage.ts, solo cambian estos valores).
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=marea_alta
R2_SECRET_ACCESS_KEY=marea_alta_dev
R2_BUCKET=marea-alta
R2_PUBLIC_BASE_URL=http://localhost:9000/marea-alta
