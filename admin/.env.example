# Contraseñas de acceso al panel (cada una habilita un rol distinto en la sesión)
ADMIN_PASSWORD_CLIENT=
ADMIN_PASSWORD_DEV=

# Secreto para firmar la cookie de sesión (JWT). Generar con:
# openssl rand -base64 32
ADMIN_SESSION_SECRET=

# OAuth App de GitHub (Settings → Developer settings → OAuth Apps) que usa
# Sveltia CMS para comitear al repo de contenido. Ver admin/README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opcional: restringe qué dominios pueden usar este proxy OAuth (protege
# contra que alguien más apunte su propia instancia de Sveltia a nuestro
# Client ID/Secret). Coma-separado, soporta comodín *.
# ALLOWED_DOMAINS=marea-alta-6m7y.vercel.app,admin.marea-alta.com
