# Hostinger / Apache — el export de Next genera "contacto.html", no
# "contacto/index.html". Sin estas reglas, /contacto responde 404.

Options -MultiViews -Indexes
DirectoryIndex index.html

# El export crea DOS cosas por ruta: contacto.html y una carpeta contacto/ con
# los payloads RSC. Sin esto Apache ve el directorio, redirige a /contacto/ y
# devuelve 403 porque adentro no hay index.html.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /contacto  ->  /contacto.html  (solo si el archivo existe)
  # Sin "!-d" a propósito: el .html tiene que ganarle a la carpeta homónima.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Cabeceras de seguridad. HTTPS y la redirección desde http ya las pone
# Hostinger; esto completa lo que falta.
<IfModule mod_headers.c>
  # El navegador recuerda por un año que este dominio va solo por HTTPS.
  # Sin includeSubDomains: no sabemos si todos los subdominios tienen SSL.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Ningún otro sitio puede meter estas páginas en un iframe (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  # El navegador no adivina el tipo de un archivo: usa el que declaramos.
  Header always set X-Content-Type-Options "nosniff"
  # A sitios externos solo se les informa el dominio, no la URL completa.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Cámara, micrófono, ubicación y pagos apagados: el sitio no los usa. No se
  # tocan los permisos que necesita el video embebido de YouTube.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Assets con hash: cache larga. HTML: siempre revalidar.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
